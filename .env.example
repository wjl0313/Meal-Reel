# 方舟：图像生成 + 文案生成
# console.volcengine.com/ark → API Key
# 直接粘贴控制台复制的完整 Key —— 它本身就含 ark- 前缀，不要再手动加一遍
# （重复前缀会报 401 "The API key format is incorrect"）
ARK_API_KEY=

# 豆包语音：配音。有两种并存的凭据体系，任选其一（A 优先）
#
# A) 旧版控制台：语音技术 → 应用管理 → 应用详情
#    console.volcengine.com/speech/service/8
#    请求头走 X-Api-App-Id + X-Api-Access-Key，实测可用
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_ACCESS_TOKEN=
#
# B) 新版控制台：豆包语音 → API Key 管理（UUID 格式）
#    请求头走 X-Api-Key。注意 key 按【项目】隔离，模型须在该项目下开通
#    两套用错都会报 45000010 —— 同一个错误码有两种原因，别只看字面意思
VOLC_SPEECH_API_KEY=

# 可选：模型与预算
DIET_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
DIET_IMAGE_MODEL_FALLBACK=doubao-seedream-5-0-flash-260915
DIET_CHAT_MODEL=doubao-seed-2-1-pro-260915
DIET_TTS_SPEAKER=zh_female_xiaohe_uranus_bigtts
DIET_MAX_COST_CNY=2.0

# 可选：单餐食材预算（元/人）。这是"不会总推贵的"的闸门：
# 超过预算的组合直接不参与排序，不是一个劲扣分。
# 参考：一荤一素一主食的正常晚餐约 ¥6-9；¥25 能吃鱼或牛肉。
DIET_BUDGET_CNY=25

# 可选：字幕字体（★ 移植到其它设备时必须确认）
# 默认 Microsoft YaHei 只在 Windows 上有。系统里没有这个字体时，
# libass 不会报错，而是静默回退到 Arial —— 中文全变方块，成片照常输出、退出码 0。
# 换机后先跑：python tools/doctor.py
#   macOS:  DIET_SUB_FONT=PingFang SC
#   Linux:  DIET_SUB_FONT=Noto Sans CJK SC
# DIET_SUB_FONT=Microsoft YaHei

# 可选：字幕与文字（默认值面向老年观众，比常见短视频字幕大一倍）
# 1080 宽下 70px 约占屏宽 6.5%；调大后每行字数会变少，程序按标点自动断行
# 注意：这几项会被 config.json 的 subs 块覆盖，以 config.json 为准
DIET_SUB_SIZE=70
DIET_SUB_TITLE_SIZE=40
DIET_SUB_STAT_SIZE=54
DIET_SUB_MARGIN_V=300
# 字幕底框透明度：00 全黑 → FF 全透。想让字更清楚就调小（如 55）
DIET_SUB_ALPHA=66

# 可选：doubao-voice 技能目录（默认 ~/.workbuddy/skills/doubao-voice）
# DOUBAO_VOICE_DIR=C:/Users/kim/.workbuddy/skills/doubao-voice
